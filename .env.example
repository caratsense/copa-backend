# ─────────────────────────────────────────────────────
# ENVIRONMENT — set this FIRST.
# ─────────────────────────────────────────────────────
# Anything other than development/dev/local/test/testing/ci/staging is treated
# as production, so a typo fails SAFE. In production the app refuses to start
# with a placeholder JWT_SECRET and refuses to accept a fixed test OTP.
ENVIRONMENT=production

# Database (Railway provides this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (Railway provides this when you add Redis)
REDIS_URL=redis://default:pass@host:6379

# ─────────────────────────────────────────────────────
# JWT — REQUIRED in production.
# ─────────────────────────────────────────────────────
# Generate a fresh one, never reuse a value from the repository:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup FAILS if this is blank, is a known placeholder, or is under 16 chars
# while ENVIRONMENT=production. Changing it logs every existing session out.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# CORS — REQUIRED. Requests from origins not listed here are blocked by the
# browser. Must include your deployed frontend URL, comma-separated.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional regex for preview deploys. Set to empty to disable.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Admin bootstrap — /users/promote-admin returns 404 unless this is set.
# Leave blank in normal operation; set it only while you need it, then remove it.
PROMOTE_SECRET=

# Bakery pickup point, stamped on a delivery when it goes out. Optional —
# defaults to the Lucknow store coordinates. Only set these if the store moves.
# BAKERY_LAT=26.8467
# BAKERY_LNG=80.9462

# ─────────────────────────────────────────────────────
# WhatsApp (Meta Cloud API)
# ─────────────────────────────────────────────────────
# WHATSAPP_ENABLED is a kill switch in BOTH directions. When false: nothing is
# sent, and inbound staff commands are refused (the webhook still returns 200 so
# Meta does not retry and disable the subscription). The website is unaffected.
WHATSAPP_ENABLED=false
# WhatsApp Manager > API Setup. These are the exact names the app reads.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Meta App Secret (App Dashboard > Settings > Basic). MANDATORY.
# The webhook FAILS CLOSED without it: every inbound request is rejected with
# 403. That is deliberate — unset, this endpoint would let anyone who knows the
# URL forge a message from any number (including the business number published
# on the website) and approve, cancel or mark orders paid.
WHATSAPP_APP_SECRET=

# Webhook verification token. Must match what you enter in the Meta dashboard.
# Use a fresh random value — anything committed to the repository is public:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Graph API version used for outbound sends. Optional.
# WHATSAPP_API_VERSION=v21.0

# Optional JSON overriding the Meta template name (and optionally language) for
# any key in app/services/wa_templates.py. Lets the Meta dashboard owner name
# templates freely without a code change. See GET /dashboard/whatsapp-templates
# for the full list of keys this deployment expects.
#   {"order_confirmation": "coc_order_confirm_v2"}
#   {"order_delivered": {"name": "coc_delivered", "language": "en_US"}}
WHATSAPP_TEMPLATE_NAMES=
# Must match the language your templates were APPROVED under in WhatsApp
# Manager ("en" vs "en_US" are different — a mismatch fails every send with
# error 132001). Check the language column in WhatsApp Manager > Templates.
WHATSAPP_TEMPLATE_LANG=en
# Accepted but currently unused by the application — no code reads it. Kept so
# existing .env files do not error. The number messages are sent FROM is
# determined by WHATSAPP_PHONE_ID, not by this.
WHATSAPP_BUSINESS_PHONE=919554444462
# Customer tracking link. The path must be /track — the page reads ?id=<order>.
# This value is ALSO where the frontend base URL is derived from when
# FRONTEND_BASE_URL is blank, so keep the trailing /track.
WHATSAPP_TRACKING_BASE_URL=https://your-app.vercel.app/track
# Accepted but currently unused by the application — no code reads it.
WHATSAPP_REVIEW_BASE_URL=https://your-app.vercel.app/menu

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────
# SMS OTP — 2factor.in (used for login + forgot-password)
# ─────────────────────────────────────────────────────
# REQUIRED in production. Without a working provider, login FAILS with 503 —
# it does not fall back to a fixed code. That fallback used to exist and meant
# any phone number plus "000000" was a complete account takeover.
SMS_ENABLED=false
TWOFACTOR_API_KEY=
# Optional: only if you created a custom AUTOGEN template in the 2factor dashboard
TWOFACTOR_TEMPLATE=

# Fixed OTP for local development. Requires BOTH a non-production ENVIRONMENT
# and this flag; startup refuses to boot if it is on in production.
# DEV_ALLOW_TEST_OTP=false
# DEV_TEST_OTP=000000

# ─────────────────────────────────────────────────────
# PayU Payment Gateway (India)
# ─────────────────────────────────────────────────────
# REQUIRED for online checkout. With these blank, POST /payments/create-order
# returns 503 and the callback refuses to settle anything — it does NOT fall
# back to marking orders paid, which is what it used to do.
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test
# Simulated payments for local development ONLY. Must stay false/unset in
# production: true means orders are marked PAID without money changing hands.
PAYU_ALLOW_DEMO_PAYMENTS=false
# This backend's own public URL — PayU redirects the payment result here.
BACKEND_BASE_URL=https://your-backend.up.railway.app
# Where the customer's browser is sent after paying. Optional: when blank it is
# derived from WHATSAPP_TRACKING_BASE_URL by stripping the trailing "/track".
# Set it explicitly if that URL ever stops ending in /track.
FRONTEND_BASE_URL=
